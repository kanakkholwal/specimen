{
  "name": "design-supply",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "lint": "bunx --bun biome lint ./src",
    "format": "bunx --bun biome format --write ./src",
    "gate:comments": "bun scripts/check-comments.mjs --all",
    "gate:dashes": "bun scripts/check-dashes.mjs",
    "gate": "bun run gate:comments && bun run gate:dashes && bun run lint && bun run check"
  },
  "dependencies": {
    "@fontsource-variable/google-sans": "^5.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@tabler/icons-svelte": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "mode-watcher": "^1.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.3.0",
    "wrangler": "^4.132.0"
  }
}
